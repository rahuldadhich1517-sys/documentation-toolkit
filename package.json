{
  "name": "@rahul_dadhich15/documentation-toolkit",
  "version": "0.1.0",
  "description": "Production-ready, browser-compatible documentation utilities for technical writing, diagram rendering, and developer tools.",
  "author": "Rahul Dadhich",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rahul_dadhich15/documentation-toolkit.git"
  },
   "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "documentation",
    "developer-tools",
    "markdown",
    "mermaid",
    "code-to-image",
    "readme-generator",
    "table-generator",
    "browser",
    "vite",
    "react"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./code-to-image": {
      "types": "./dist/code-to-image/index.d.ts",
      "import": "./dist/code-to-image/index.js",
      "require": "./dist/code-to-image/index.cjs"
    },
    "./readme-generate": {
      "types": "./dist/readme-generate/index.d.ts",
      "import": "./dist/readme-generate/index.js",
      "require": "./dist/readme-generate/index.cjs"
    },
    "./html-table-generate": {
      "types": "./dist/html-table-generate/index.d.ts",
      "import": "./dist/html-table-generate/index.js",
      "require": "./dist/html-table-generate/index.cjs"
    },
    "./markdown-edit": {
      "types": "./dist/markdown-edit/index.d.ts",
      "import": "./dist/markdown-edit/index.js",
      "require": "./dist/markdown-edit/index.cjs"
    },
    "./markdown-table": {
      "types": "./dist/markdown-table/index.d.ts",
      "import": "./dist/markdown-table/index.js",
      "require": "./dist/markdown-table/index.cjs"
    },
    "./markdown-toc": {
      "types": "./dist/markdown-toc/index.d.ts",
      "import": "./dist/markdown-toc/index.js",
      "require": "./dist/markdown-toc/index.cjs"
    },
    "./mermaid-render": {
      "types": "./dist/mermaid-render/index.d.ts",
      "import": "./dist/mermaid-render/index.js",
      "require": "./dist/mermaid-render/index.cjs"
    },
    "./license-generate": {
      "types": "./dist/license-generate/index.d.ts",
      "import": "./dist/license-generate/index.js",
      "require": "./dist/license-generate/index.cjs"
    },
    "./readme-badge": {
      "types": "./dist/readme-badge/index.d.ts",
      "import": "./dist/readme-badge/index.js",
      "require": "./dist/readme-badge/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:browser": "playwright test",
    "test:smoke": "vitest run tests/all-utilities-smoke.test.ts",
    "test:consumer": "node scripts/test-consumer.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "dompurify": "^3.2.4",
    "marked": "^15.0.7",
    "mermaid": "^11.4.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.13.4",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "@vitest/coverage-v8": "^3.0.5",
    "eslint": "^9.20.1",
    "happy-dom": "^17.1.5",
    "jsdom": "^31.0.1",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
